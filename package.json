{
	"name": "custom-selected-word-count",
	"version": "1.7.1",
	"description": "Comprehensive text analysis for selected text including word counting, character counting, and sentence counting with modern UI design",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node ./node_modules/vitest/vitest.mjs run",
		"test:watch": "node ./node_modules/vitest/vitest.mjs",
		"watch": "node esbuild.config.mjs dev"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/banisterious/obsidian-custom-selected-word-count"
	},
	"bugs": {
		"url": "https://github.com/banisterious/obsidian-custom-selected-word-count/issues"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"word-count",
		"selected-word-count",
		"text-analysis"
	],
	"author": "John Banister",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.0.0",
		"esbuild": "0.17.3",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"obsidian": "1.4.11",
		"tslib": "2.4.0",
		"typescript": "~4.9",
		"typescript-eslint": "^8.59.3",
		"vitest": "^3.2.4"
	}
}
